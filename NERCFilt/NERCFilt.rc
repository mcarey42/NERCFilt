// NERCFilt.rc - version resource.
//
// Part of NERCFilt.  SPDX-License-Identifier: MIT

#include <winres.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION NERCFILT_VERSION_MAJOR,NERCFILT_VERSION_MINOR,NERCFILT_VERSION_PATCH,0
 PRODUCTVERSION NERCFILT_VERSION_MAJOR,NERCFILT_VERSION_MINOR,NERCFILT_VERSION_PATCH,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Peak Security, Inc."
            VALUE "FileDescription", "NERCFilt NERC CIP-007 password filter"
            VALUE "FileVersion", NERCFILT_VERSION_STRING
            VALUE "InternalName", "NERCFilt"
            VALUE "LegalCopyright", "Copyright (c) 2013-2026 Mark G. Carey, Peak Security, Inc. MIT License."
            VALUE "OriginalFilename", "NERCFilt.dll"
            VALUE "ProductName", "NERCFilt"
            VALUE "ProductVersion", NERCFILT_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
